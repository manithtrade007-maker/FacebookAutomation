# ── Google Gemini (FREE — get at aistudio.google.com) ───
GEMINI_API_KEY=your_gemini_api_key_here

# ── Edge-TTS (FREE — no key needed, Microsoft voices) ───
# No API key required for Edge-TTS

# ── Claude (Anthropic) — OPTIONAL paid upgrade ──────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── ElevenLabs — OPTIONAL paid upgrade ──────────────────
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ── Facebook / Meta ─────────────────────────────────────
FB_PAGE_ID=your_facebook_page_id_here
FB_ACCESS_TOKEN=your_facebook_page_access_token_here

# ── Reddit (optional — for trend research) ──────────────
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=FacebookBot/1.0

# ── Pexels (free stock footage) ─────────────────────────
PEXELS_API_KEY=your_pexels_api_key_here

# ── App Settings ────────────────────────────────────────
NICHE=tech                  # tech | finance | health | ai
TARGET_AUDIENCE=US          # US | UK | AU | CA  (affects posting time)
VIDEOS_PER_DAY=1
POST_TIME=18:00             # 6 PM — prime US time
